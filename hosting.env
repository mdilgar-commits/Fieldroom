# Hosting choices for copies that run from this repository, such as Google AI Studio.
# These are not secrets. Settings in the hosting environment override this file.
#
# ALLOW_PUBLIC_ACCESS=true runs a hosted copy WITHOUT SIGN-IN: anyone with the link
# can view and change the project, and its data is erased when the server restarts.
# Fine for a demo. Change it to false once Firebase sign-in is set up.
ALLOW_PUBLIC_ACCESS=true
