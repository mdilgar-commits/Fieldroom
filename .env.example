# Local development can leave the Firebase settings blank.
# In Cloud Run, set CLOUD_MODE=true and use a runtime service account with access
# to Firestore (including uploaded file chunks). Do not put service-account JSON in this file.
CLOUD_MODE=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIRESTORE_STATE_PATH=fieldroomProjects/default/state/current
CLOUD_DATA_PREFIX=default
ALLOWED_EMAILS=

# Optional: enables Gemini-assisted room/deliverable extraction.
# Configure as a server-side secret; never put this in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=4173
