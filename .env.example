# Copy this file to .env and fill in what you need. `npm start` loads .env automatically.
# Everything is optional for local use: with no values the app runs on http://localhost:3000
# with no sign-in, and stores data in ./data on this computer.

# PORT=3000
# HOST=127.0.0.1   # Local mode has no sign-in. Only set 0.0.0.0 on a network you trust.

# Optional: enables Gemini-assisted room/deliverable extraction (server-side only).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hosted (cloud) mode only. Leave CLOUD_MODE=false for local use.
# When CLOUD_MODE=true, the Firebase values and ALLOWED_EMAILS are required.
# ALLOWED_EMAILS format: email[:role], comma-separated; role is project_manager (default) or field_team.
#   e.g. ALLOWED_EMAILS=pm@example.com:project_manager,super@example.com:field_team
CLOUD_MODE=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIRESTORE_STATE_PATH=fieldroomProjects/default/state/current
CLOUD_DATA_PREFIX=default
ALLOWED_EMAILS=
