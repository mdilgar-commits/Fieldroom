# Settings Fieldroom reads. In Google AI Studio, enter values in Settings > Secrets.
# Your own Gemini API key from https://aistudio.google.com/apikey (starts with AQ. or AIza).
FIELDROOM_GEMINI_KEY=
# Leave blank for the free default (gemini-3.5-flash-lite).
GEMINI_MODEL=
# true = no sign-in demo; set in hosting.env already.
ALLOW_PUBLIC_ACCESS=
